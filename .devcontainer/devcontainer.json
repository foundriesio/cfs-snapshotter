{
  "//": "SPDX-License-Identifier: Apache-2.0",
  "name": "cfs-snapshotter runtime test",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "GO_VERSION": "1.26",
      "DOCKER_VERSION": "29.3.0",
      "CONTAINERD_VERSION": "2.2.2",
      "RUNC_VERSION": "1.3.3",
      "CNI_PLUGINS_VERSION": "1.8.0",
      "ZOT_VERSION": "2.1.17",
      "EROFS_UTILS_VERSION": "1.9.2",
      "GOLANGCI_LINT_VERSION": "2.6.2"
    },
    "options": [
      "--output=type=docker"
    ]
  },
  "remoteUser": "root",
  "runArgs": [
    "--privileged",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cgroupns=host"
  ],
  "containerEnv": {
    "CFS_DEVCONTAINER": "1",
    "GOCACHE": "/tmp/cfs-gocache",
    "GOMODCACHE": "/tmp/cfs-gomodcache",
    "PATH": "/opt/cfs-dev/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "CONTAINERD_SNAPSHOTTER": "cfs"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "editor.formatOnSave": true,
        "[go]": {
          "editor.formatOnSave": true
        }
      }
    }
  },
  "overrideCommand": false
}
