[Unit]
Description=composefs-backed remote snapshotter for containerd
Documentation=https://github.com/foundriesio/cfs-snapshotter
# Start before the runtimes that consult the snapshotter. Ordering only, not
# a dependency: both sides reconnect, so either order eventually works.
Before=containerd.service docker.service

[Service]
# notify: the daemon reports readiness and pushes the containerd probe's
# verdict as the status line systemctl status shows.
Type=notify
EnvironmentFile=-/etc/default/cfs-snapshotter
ExecStart=/usr/bin/containerd-cfs-grpc $CFS_OPTS
Restart=always
RestartSec=2
# Exit status 3 means an unmet runtime prerequisite (missing mkcomposefs, a
# store without fs-verity in a build that requires it, a containerd that
# cannot drive this snapshotter):
# restarting cannot succeed until an administrator fixes it, so the unit goes
# straight to the failed state. Recover with systemctl restart after the fix.
RestartPreventExitStatus=3
RuntimeDirectory=containerd-cfs-grpc

[Install]
WantedBy=multi-user.target
